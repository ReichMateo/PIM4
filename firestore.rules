rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection: Users can only read, create, update, and delete their own tasks
    match /tasks/{taskId} {
      // Allow read/delete if user is authenticated and is the owner of the document
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow update only by the owner, and the owner can't be reassigned
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;

      // Allow create if user is authenticated and sets themselves as the userId owner
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}