# =========================================================
# Firebase Configuration (Frontend - Public/Vite)
# =========================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# =========================================================
# AWS SES Email Service Configuration (Backend Serverless)
# NOTE: DO NOT use VITE_ prefix for AWS keys so they never leak to frontend
# =========================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SES_SENDER_EMAIL=noreply@yourdomain.com
